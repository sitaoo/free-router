[Unit]
Description=Ordered OpenRouter free-model gateway for Hermes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dannyaw/openrouter-free-router
EnvironmentFile=-/home/dannyaw/.hermes/.env
ExecStart=/usr/bin/node /home/dannyaw/openrouter-free-router/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
