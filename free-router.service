[Unit]
Description=Free Router local model gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/free-router/app
EnvironmentFile=-%h/.hermes/.env
EnvironmentFile=-%h/free-router/data/.env
ExecStart=/usr/bin/node %h/free-router/app/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
