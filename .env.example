# Copy to `.env` and fill in the keys you have. Do not commit `.env`.
#
# Values already present in the process environment win. Next is this file,
# then `~/.hermes/.env` if you already keep keys there.

# Required for OpenRouter models, catalog refresh, and weekly discovery.
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional. TokenRouter free GLM-5.3 on the shared `free-best` ranking.
# TOKENROUTER_API_KEY=

# Optional. B.AI Limited Free models on the shared `free-best` ranking.
# https://chat.b.ai
# BAI_API_KEY=

# Optional. Extra providers only need a key named `<NAME>_API_KEY`.
# Example: adding `"groq"` in config.json reads GROQ_API_KEY and GROQ_BASE_URL.
# GROQ_API_KEY=

# Optional overrides
# FREE_ROUTER_HOST=127.0.0.1
# FREE_ROUTER_PORT=8787
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# BAI_BASE_URL=https://api.b.ai/v1
# OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
# OPENROUTER_APP_NAME=Free Router
